# Copy to backend/.env
SUPABASE_URL=https://your-project.supabase.co
# The same publishable (or legacy anon) key as the front end. The API acts as the
# signed-in user, so row level security applies. Never use the service-role key here.
SUPABASE_KEY=your-publishable-key
GEMINI_API_KEY=your-gemini-key
# Front-end origins allowed to call the API from another domain, comma-separated
ALLOWED_ORIGINS=http://localhost:5173
# Gives the cat a voice (backend/app/voice.py)
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional: any voice id from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
